# ==========================================
# MULTI-AGENT BI PLATFORM CONFIGURATION
# ==========================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
APP_NAME="Multi-Agent AI Business Analyst"
API_V1_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate a secure 32-byte secret in Python using: secrets.token_hex(32)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_GUEST_MODE=true

# Password Recovery Email Service (Optional for Production SMTP; Dev mode auto-provides recovery links)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@bi-platform.enterprise.com"

# Database Connection
# Local Development: SQLite
DATABASE_URL="sqlite:///./data/bi_system.db"
# Production (Supabase):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# AI / LLM Configuration (OpenRouter Free Models / Local Ollama)
# Get a free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
DEFAULT_LLM_MODEL="google/gemini-2.0-flash-exp:free"
FALLBACK_LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"
AI_REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=3

# Optional: Local Ollama (set to true to run fully offline)
USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# File Storage & Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=".csv,.xlsx,.xls"
TEMP_UPLOAD_DIR="./data/uploads"
REPORTS_DIR="./data/reports"
FILE_RETENTION_HOURS=24

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:8000"

